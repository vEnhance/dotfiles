{
  "env": {
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "EDITOR": "vim"
  },
  "permissions": {
    "defaultMode": "auto",
    "allow": ["Read(//tmp/**)", "Edit(//tmp/**)"],
    "deny": [
      "Edit(//tmp/claude-1000/bash-edit-diff)",
      "Edit(//tmp/claude-1000/*/*/tasks/**)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": false,
    "filesystem": {
      "allowWrite": [
        "~/.cache",
        "~/.texlive",
        "~/.npm",
        "~/.cargo/registry",
        "~/.cargo/git",
        "~/go/pkg/mod"
      ],
      "denyWrite": [
        "~/.cache/claude-cli-nodejs",
        "~/.cache/claude-statusline.json"
      ]
    }
  },
  "model": "opus",
  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": true
  },
  "alwaysThinkingEnabled": true,
  "tui": "fullscreen",
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  }
}
