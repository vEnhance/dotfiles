unalternates *
alternates '@evanchen\.cc' '^evanchen@alum.mit\.edu$'

set folder=~/Mail/work/
set header_cache=~/.cache/mutt/work

set smtp_url=`echo smtp://$(pass show neomutt/pm-access)@smtp.postmarkapp.com:587`
set smtp_pass = `pass show neomutt/pm-secret`
set from = "evan@evanchen.cc"
source ~/secrets/mailreceipts # set BCC header

set imap_user = `echo $(jq -r ".user1" ~/secrets/mail-users.json)@gmail.com`
set imap_pass = `pass show neomutt/key1`
set spoolfile = +Inbox
set postponed = +Drafts

color indicator  brightwhite  green
color status     brightwhite  green

color sidebar_divider green white
