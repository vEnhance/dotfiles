set default-bg "#001337"
set dbus-service true
set synctex true
# set synctex-editor-command "gvim --servername GVIM --remote +%{line} %{input}"
set synctex-editor-command "evans-synctex-wrapper %{line} '%{input}'"

map , set "first-page-column 1:1"
map . set "first-page-column 1:2"
map e exec "sh -c 'xfce4-terminal --working-directory=\"$(dirname $FILE)\"'"
map b exec "sh -c 'thunar \"$(dirname $FILE)\"'"
map z exec "sh -c 'zathura \"$FILE\"'"
map c exec "xfce4-terminal -e 'sh -c \"latexmk -cd $(echo $FILE | sed s/pdf\$/tex/)\"'"
map p exec "xfce4-terminal -e 'sh -c \"latexmk -pvc -cd $(echo $FILE | sed s/pdf\$/tex/)\"'"

# vim: ft=config
