    \usepackage{epigraph}
    \renewcommand{\epigraphsize}{\scriptsize}
    \renewcommand{\epigraphwidth}{60ex}

    % Tiny optimizations:
    \usepackage{mathtools}
    \usepackage{microtype}
    \usepackage{xstring}
    \usepackage{wrapfig}
    \ifevanbritish\usepackage[cleanlook,british]{isodate}\fi % day-first date
    \usepackage{tikz-cd}
