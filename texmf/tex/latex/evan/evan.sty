    % a list I like for walkthrough's --- Drew-style parts
    \newlist{walk}{enumerate}{3}
    \setlist[walk]{label=\bfseries (\alph*)}
    % list item for MO style rubrics
    \newcommand{\evan@worthdots}{\def\hfill{\hskip 20pt plus 1fill}\dotfill}
    \newcommand{\evan@points}[1]{#1~point\IfEndWith{#1}{1}{}{s}}
    \newcommand{\worth}[1]{\evan@worthdots
      \IfEq{#1}{0}{\textbf{\evan@points{#1}}}%
      {\textbf{\color{blue}\evan@points{#1}}}%
      \par}
    \newcommand{\subworth}[1]{\evan@worthdots
      \IfEq{#1}{0}{{\footnotesize\evan@points{#1}}}%
      {\textbf{\footnotesize\evan@points{#1}}}%
      \par}
    \newlist{rubric}{enumerate}{2}
    \setlist[rubric,1]{label=\Roman*.}
    \setlist[rubric,2]{label=(\Roman{rubrici}.\alph*)}
  \fi

  %%fakesubsection %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
  %                   CONFIGURATION OF \maketitle FOR KOMA                    %
  %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
  \evan@ifkoma{
    \addtokomafont{subtitle}{\Large}
    \setkomafont{author}{\Large\scshape}
    \setkomafont{date}{\Large\normalsize}
  }{}
  \providecommand{\thetitle}{\@title}
  \providecommand{\theauthor}{\@author}
  \providecommand{\thedate}{\@date}

  %%fakesubsection %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
  %                   PAGE LAYOUT (MARGINS, HEADING, ETC.)                    %
  %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
  \ifevanfancy
    \setlength{\headsep}{10pt}
    \evan@ifkoma
    {
      \usepackage[headsepline]{scrlayer-scrpage}
      \renewcommand{\headfont}{}
      \addtolength{\textheight}{3.14cm}
      \setlength{\footskip}{0.5in}
      \ifevanhdr
        \ihead{\footnotesize\textbf{\theauthor} --- \thedate}
        \automark{section}
        \chead{}
        \ohead{\footnotesize\textbf{\thetitle}}
        \cfoot{\pagemark}
      \else
        % keep just the page number, as the non-KOMA branch does
        \pagestyle{plain}
      \fi
    }
    {
      \usepackage{fancyhdr}
      \setlength{\headheight}{0.75in}
      \setlength{\oddsidemargin}{0in}
      \setlength{\evensidemargin}{0in}
      \setlength{\voffset}{-1.0in}
      \setlength{\textwidth}{6.5in}
      \setlength{\headwidth}{6.5in}
      \setlength{\textheight}{8.75in}
      \setlength{\parskip}{1ex plus 0.5ex minus 0.2ex}
      \setlength{\footskip}{0.3in}
      \ifevanhdr
        \renewcommand{\headrulewidth}{0.5pt}
        \renewcommand{\footrulewidth}{0.0pt}
        \pagestyle{fancy}
        \lhead{Evan Chen}
        \chead{}
        \rhead{\nouppercase{\leftmark}}
        \lfoot{}
        \cfoot{\thepage}
        \rfoot{}
      \fi
    }
  \fi

