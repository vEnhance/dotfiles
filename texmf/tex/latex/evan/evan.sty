% We include "Evan" in all of these to avoid collisions with external packages
% \evan@boolopt{name}{true|false} declares the switch \ifevanNAME
\newcommand{\evan@boolopt}[2]{%
  \expandafter\newif\csname ifevan#1\endcsname
  \csname evan#1#2\endcsname
  \DeclareOption{#1}{\csname evan#1true\endcsname}%
  \DeclareOption{no#1}{\csname evan#1false\endcsname}%
}
\evan@boolopt{asy}{true}        % Enable Asympote package
\evan@boolopt{author}{true}     % Set author to "Evan Chen"
\evan@boolopt{bib}{false}       % BibLaTeX
\evan@boolopt{british}{true}    % Use British dates (e.g. 1 September 2026)
\evan@boolopt{boxthm}{false}    % Use tcolorbox-styled theorems
\evan@boolopt{chinese}{false}   % Chinese support
\evan@boolopt{colorsec}{false}  % Colorful section numbers
\evan@boolopt{fancy}{true}      % Page margin control
\evan@boolopt{hdr}{true}        % Page header control
\evan@boolopt{hints}{false}     % Enable hint support
\evan@boolopt{href}{true}       % Load hyperref package
\evan@boolopt{patchasy}{false}  % Patches the Asymptote package for Evan (patchasy.sty)
\evan@boolopt{pkg}{true}        % Loads some convenience / QoL packages
\evan@boolopt{secthm}{false}    % Label theorems within section
\evan@boolopt{setup}{true}      % Disable to turn off almost everything
\evan@boolopt{thm}{true}        % Whether to _define_ theorem environments
\evan@boolopt{von}{false}       % Enables the von package
\DeclareOption{sexy}{\evansecthmtrue\evanboxthmtrue\evancolorsectrue} % for longer docs
\DeclareOption{american}{\evanbritishfalse} % alias for nobritish
% mdthm/nomdthm are the pre-2026 spelling, from when the boxes were mdframed
\newcommand{\evan@warn@mdthm}{\PackageWarning{evan}{%
  Options `mdthm' and `nomdthm' are deprecated\MessageBreak
  (the boxes are tcolorbox now, not mdframed).\MessageBreak
  Use `boxthm' and `noboxthm' instead}}
\DeclareOption{mdthm}{\evanboxthmtrue\evan@warn@mdthm}
\DeclareOption{nomdthm}{\evanboxthmfalse\evan@warn@mdthm}
\newcommand{\evan@ifkoma}[2]{\@ifundefined{KOMAClassName}{#2}{#1}}

\ProcessOptions\relax
% if packages not loaded, turn off boxthm and asy
\ifevanpkg\else\evanboxthmfalse\evanasyfalse\fi
% If no setup, turn off theorems
\ifevansetup\else\evanthmfalse\fi
% keytheorems is needed by boxthm too, even if no theorems are declared here.
\newif\ifevan@thmpkg
\ifevanthm\evan@thmpkgtrue\fi
\ifevanboxthm\evan@thmpkgtrue\fi


