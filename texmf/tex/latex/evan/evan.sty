    \usepackage{tcolorbox}
    \tcbuselibrary{skins,breakable,hooks}
    % Text right after \end{theorem} should continue the same paragraph
    \AddToHook{env/tcolorbox/after}{\@doendpe}

    \tcbset{
      evanbox/.style={ % shared by all
        enhanced, coltitle=black, fonttitle=\bfseries,
        left=8pt, right=8pt, top=6pt, bottom=6pt,
      },
      evanbg/.style={colback=#1, colbacktitle=#1},
      evansidebar/.style={
        evanbox, breakable, sharp corners, boxrule=0pt, frame hidden,
        before skip=8pt, left=10pt, right=10pt,
      },
      % --------------------------------------------------------
      bluebox/.style={
        evanbox, evanbg=TealBlue!5, arc=9pt, outer arc=10pt,
        colframe=blue, boxrule=1pt, before skip=12pt, after skip=12pt,
      },
      redbox/.style={
        evanbox, evanbg=Salmon!5, sharp corners,
        colframe=RawSienna, boxrule=0.5pt, before skip=12pt, after skip=12pt,
      },
      greenbox/.style={
        evansidebar, evanbg=ForestGreen!5,
        borderline west={2pt}{0pt}{ForestGreen}, after skip=0pt,
      },
      blackbox/.style={
        evansidebar, evanbg=RedViolet!5!gray!5,
        borderline west={3pt}{0pt}{black}, top=3pt, bottom=2pt,
      },
      purplebox/.style={
        evanbox, arc=9pt, outer arc=10pt, colframe=black, colback=Orchid!10,
        boxrule=1pt, colbacktitle=Violet!50!black, coltitle=white,
        fonttitle=\bfseries\sffamily, drop shadow=black!30,
        before skip=12pt, after skip=12pt, left=10pt, right=10pt,
      },
      % --------------------------------------------------------
