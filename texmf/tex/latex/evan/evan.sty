  \ifevanthm
    \ifevansecthm
      \newcounter{thmcounter}[section]
      \renewcommand{\thethmcounter}{\thesection.\arabic{thmcounter}}
    \else
      \newcounter{thmcounter}
    \fi
    % #3 (the displayed name) defaults to the capitalized env name #1
    \NewDocumentCommand{\evan@thm}{ m m O{\makefirstuc{#1}} }{%
      \ifevanboxthm
        \newkeytheorem{#1}[style=#2,name=#3,sibling=thmcounter]
        \newkeytheorem{#1*}[style=#2,name=#3,numbered=no]
      \else
        \newkeytheorem{#1}[name=#3,sibling=thmcounter]
        \newkeytheorem{#1*}[name=#3,numbered=no]
      \fi
    }
    \evan@thm{theorem}{thmbluebox}
    \evan@thm{lemma}{thmbluebox}
    \evan@thm{proposition}{thmbluebox}
    \evan@thm{corollary}{thmbluebox}
    \evan@thm{assume}{thmbluebox}[Assumption]
    \theoremstyle{definition}
    \evan@thm{algorithm}{thmgreenbox}
    \evan@thm{claim}{thmgreenbox}
    \evan@thm{example}{thmredbox}
    \evan@thm{remark}{thmblackbox}
    \evan@thm{answer}{thminline}
    \evan@thm{conjecture}{thminline}
    \evan@thm{definition}{thminline}
    \evan@thm{exercise}{thminline}
    \evan@thm{fact}{thminline}
    \evan@thm{problem}{thminline}
