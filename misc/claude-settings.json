{
  "env": {
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1"
  },
  "permissions": {
    "defaultMode": "auto"
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": false,
    "filesystem": {
      "allowWrite": [
        "~/.cache",
        "~/.npm",
        "~/.cargo/registry",
        "~/.cargo/git",
        "~/go/pkg/mod"
      ],
      "denyWrite": [
        "~/.cache/claude-cli-nodejs",
        "~/.cache/claude-statusline.json"
      ]
    }
  },
  "model": "opus",
  "alwaysThinkingEnabled": true,
  "tui": "fullscreen",
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  }
}
